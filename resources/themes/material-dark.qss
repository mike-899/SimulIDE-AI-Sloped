/* Material 3 theme for SimulIDE (dark) - generated */
* { font-family: "Inter", "Roboto", "Noto Sans", "Segoe UI", sans-serif; }

QMainWindow, QDialog, QWidget#centralWidget { background: #1E1F22; color: #E3E3E8; }
QWidget { color: #E3E3E8; selection-background-color: #A8C7FA; selection-color: #062E6F; }

/* Splitters */
QSplitter::handle { background: #3F4147; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: #A8C7FA; }

/* Buttons */
QPushButton {
    background: #313338; color: #E3E3E8; border: 1px solid #3F4147;
    border-radius: 18px; padding: 6px 16px; min-height: 20px;
}
QPushButton:hover { background: #3A3C42; border-color: #A8C7FA; }
QPushButton:pressed { background: #45474E; }
QPushButton:checked { background: #0B57D0; color: #D3E3FD; border-color: #A8C7FA; }
QPushButton:disabled { color: #6B6E76; border-color: #3F4147; }
QPushButton:default { background: #A8C7FA; color: #062E6F; border: none; }

QToolButton {
    background: transparent; border: 1px solid transparent; border-radius: 8px;
    padding: 4px; color: #E3E3E8;
}
QToolButton:hover { background: #3A3C42; }
QToolButton:pressed { background: #45474E; }
QToolButton:checked { background: #0B57D0; color: #D3E3FD; }
QToolButton::menu-indicator { image: none; }

QToolBar { background: #2B2D31; border: none; border-bottom: 1px solid #3F4147; spacing: 4px; padding: 4px; }
QToolBar::separator { background: #3F4147; width: 1px; margin: 6px 4px; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background: #2B2D31; color: #E3E3E8; border: 1px solid #3F4147;
    border-radius: 8px; padding: 4px 8px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 2px solid #A8C7FA; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView { background: #2B2D31; border: 1px solid #3F4147; border-radius: 8px; padding: 4px; outline: 0; }
QCheckBox, QRadioButton { spacing: 8px; }

/* Menus */
QMenuBar { background: #2B2D31; border-bottom: 1px solid #3F4147; padding: 2px; }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 6px; }
QMenuBar::item:selected { background: #3A3C42; }
QMenu { background: #313338; border: 1px solid #3F4147; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 6px; }
QMenu::item:selected { background: #3A3C42; }
QMenu::item:disabled { color: #6B6E76; }
QMenu::separator { height: 1px; background: #3F4147; margin: 4px 8px; }

/* Tabs */
QTabWidget::pane { border: none; border-top: 1px solid #3F4147; background: #2B2D31; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent; color: #9AA0A6; padding: 8px 14px; border: none;
    border-bottom: 3px solid transparent;
}
QTabBar::tab:west, QTabBar::tab:east { border-bottom: none; border-right: 3px solid transparent; padding: 14px 8px; }
QTabBar::tab:hover { background: #3A3C42; color: #E3E3E8; }
QTabBar::tab:selected { color: #A8C7FA; border-bottom-color: #A8C7FA; }
QTabBar::tab:west:selected { border-right-color: #A8C7FA; }
QTabBar::close-button { subcontrol-position: right; }

/* Item views */
QTreeView, QListView, QTableView, QTreeWidget, QListWidget, QTableWidget {
    background: #2B2D31; alternate-background-color: #313338; border: none;
    outline: 0; show-decoration-selected: 1;
}
QTreeView::item, QListView::item { padding: 3px 4px; border-radius: 6px; }
QTreeView::item:hover, QListView::item:hover { background: #3A3C42; }
QTreeView::item:selected, QListView::item:selected { background: #0B57D0; color: #D3E3FD; }
QHeaderView::section { background: #313338; color: #9AA0A6; border: none; border-bottom: 1px solid #3F4147; padding: 4px 8px; }
QTableView { gridline-color: #3F4147; }

/* Docks */
QDockWidget { titlebar-close-icon: none; color: #E3E3E8; }
QDockWidget::title { background: #313338; padding: 6px 10px; border-bottom: 1px solid #3F4147; }

/* Scrollbars */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle { background: #4A4D55; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 32px; }
QScrollBar::handle:horizontal { min-width: 32px; }
QScrollBar::handle:hover { background: #6B6E76; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* Tooltips */
QToolTip { background: #E3E3E8; color: #1B1B1F; border: none; border-radius: 6px; padding: 5px 8px; }

QGroupBox { border: 1px solid #3F4147; border-radius: 10px; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9AA0A6; }
QSlider::groove:horizontal { height: 4px; background: #3F4147; border-radius: 2px; }
QSlider::handle:horizontal { background: #A8C7FA; width: 14px; margin: -6px 0; border-radius: 7px; }
QProgressBar { border: none; background: #3F4147; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background: #A8C7FA; border-radius: 4px; }
QStatusBar { background: #2B2D31; border-top: 1px solid #3F4147; }
QGraphicsView { border: none; background: #1E1F22; }

/* ---- Tinkercad-style layout objects ---- */
#topBar { background: #2B2D31; border-bottom: 1px solid #3F4147; }
#editToolBar { background: #2B2D31; border-bottom: 1px solid #3F4147; }
#topBar QToolButton, #editToolBar QToolButton { border-radius: 8px; padding: 6px; }

QPushButton#simButton, QToolButton#simButton {
    background: #1E8E3E; color: #FFFFFF; border: none; border-radius: 18px;
    padding: 6px 20px; font-weight: 600;
}
QPushButton#simButton:hover, QToolButton#simButton:hover { background: #188038; }
QPushButton#simButton:checked, QToolButton#simButton:checked { background: #D93025; color: #FFFFFF; }
QPushButton#simButton:checked:hover, QToolButton#simButton:checked:hover { background: #C5221F; }
QPushButton#simButton[simState="On"], QToolButton#simButton[simState="On"] { background: #D93025; }

QPushButton#codeButton, QToolButton#codeButton {
    background: #A8C7FA; color: #062E6F; border: none; border-radius: 18px;
    padding: 6px 18px; font-weight: 600;
}
QPushButton#codeButton:hover, QToolButton#codeButton:hover { background: #C2D7FB; }
QPushButton#codeButton:checked, QToolButton#codeButton:checked { background: #0B57D0; color: #D3E3FD; }

#componentPanel { background: #2B2D31; border-left: 1px solid #3F4147; }
QLineEdit#componentSearch {
    background: #313338; border: 1px solid #3F4147; border-radius: 18px; padding: 6px 14px;
}
QLineEdit#componentSearch:focus { border: 2px solid #A8C7FA; }
#componentCard {
    background: #2B2D31; border: 1px solid #3F4147; border-radius: 12px; padding: 6px;
}
#componentCard:hover { background: #313338; border: 1px solid #A8C7FA; border-bottom: 3px solid #111214; }

QPushButton#themeToggleButton, QToolButton#themeToggleButton {
    background: #313338; border: 1px solid #3F4147; border-radius: 16px; padding: 4px 10px;
}
QPushButton#themeToggleButton:hover, QToolButton#themeToggleButton:hover { background: #3A3C42; }
